#!/usr/bin/env bash
# arc -- document search over the arc index, via the running Emacs daemon.
#
# The daemon is the point. arc's database is already open there, warm, with
# vec0 loaded; an `emacs --batch' CLI would pay cold start, reload the
# extension, contend with the live WAL and duplicate the retrieval code. The
# cost of that choice is this script's one real failure mode, which is why it
# gets its own exit status rather than a cryptic emacsclient message.
set -uo pipefail

die()  { printf 'Error: %s\n' "$1" >&2; exit 1; }
dead() { printf 'Error: arc: emacs daemon not running\n' >&2; exit 2; }

usage() {
  cat >&2 <<'USAGE'
usage: arc <command> [options]

  arc search QUERY [--scope NAME] [--limit N] [--arm keyword|fused] [--json]
  arc scopes [--json]
  arc stats  [--json]

Exit: 0 ok, 1 error, 2 emacs daemon not running.
USAGE
  exit 1
}

# Evaluate an elisp form in the daemon. Distinguishes "no daemon" from "the
# form signalled": emacsclient exits non-zero for the former and prints a
# *ERROR* line for the latter.
#
# `arc-tool-*' returns the result of `json-serialize', which Emacs documents
# as a *unibyte* UTF-8-encoded string. Handed straight to emacsclient's
# printer, every byte >= 128 (an em dash, a curly quote, any accented
# letter -- all routine in real notes) comes back octal-escaped, e.g.
# \342\200\224, which the quote/backslash unescape below cannot undo and
# which breaks JSON parsing outright. `decode-coding-string' turns the
# unibyte JSON bytes back into a proper multibyte Lisp string first, so the
# characters print as themselves.
evaluate() {
  local out status
  out=$(emacsclient -e "$1" 2>&1); status=$?
  if [ $status -ne 0 ]; then
    case "$out" in
      # emacsclient exits non-zero for a signalled Lisp error too, with the
      # error text prefixed "*ERROR*: ". This branch must come first: a
      # signalled error's own text is free-form -- `arc-index.el' and
      # `arc-watch.el' both emit messages like "arc: could not reindex
      # ..." -- and an unanchored *later* pattern below matching on
      # "could not" would shadow a real Lisp error and misreport it as a
      # dead daemon, sending a caller off to start a daemon that is
      # already running while discarding the actual failure.
      \*ERROR\**) die "${out#\*ERROR\*: }" ;;
      # These are emacsclient's own transport failures, not anything the
      # daemon's Lisp said, so they are anchored on "emacsclient:" (the
      # prefix emacsclient puts on every line it prints itself) rather
      # than matched on bare substrings that a signalled error could also
      # contain.
      *emacsclient:*"can't find socket"*|*emacsclient:*"No socket"*|*emacsclient:*"Connection refused"*|*emacsclient:*"could not"*) dead ;;
      *) die "${out:-emacsclient failed}" ;;
    esac
  fi
  # emacsclient renders a string result as a quoted elisp literal; unwrap it.
  printf '%s' "$out" | sed -e 's/^"//' -e 's/"$//' -e 's/\\"/"/g' -e 's/\\\\/\\/g'
  printf '\n'
}

command -v emacsclient >/dev/null 2>&1 || die "emacsclient not found on PATH"

[ $# -ge 1 ] || usage
cmd="$1"; shift

query=""; scope=""; limit=""; arm="nil"; json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --scope)
      # A trailing `--scope' with nothing after it must not become a
      # `shift 2' with only one argument left: that shifts NOTHING (no
      # `set -e' is in effect to catch the failing shift), so `$#' never
      # decreases and the `while [ $# -gt 0 ]' loop above spins forever.
      [ $# -ge 2 ] || die "--scope needs a value"
      scope="$2"; shift 2 ;;
    --limit)
      [ $# -ge 2 ] || die "--limit needs a value"
      case "$2" in
        ''|*[!0-9]*) die "--limit must be a positive integer, got: $2" ;;
      esac
      limit="$2"; shift 2 ;;
    --arm)
      [ $# -ge 2 ] || die "--arm needs a value"
      case "$2" in
        keyword|fused) arm="(quote $2)" ;;
        *) die "--arm must be 'keyword' or 'fused', got: $2" ;;
      esac
      shift 2 ;;
    --json)  json=1; shift ;;
    --help|-h) usage ;;
    -*) die "unknown option: $1" ;;
    *) if [ -z "$query" ]; then query="$1"; else query="$query $1"; fi; shift ;;
  esac
done

# Elisp string literal: escape backslashes first, then quotes.
elisp_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

case "$cmd" in
  search)
    [ -n "$query" ] || die "search needs a query"
    form="(decode-coding-string (progn (require 'arc-tool) (arc-tool-search $(elisp_string "$query") $( [ -n "$scope" ] && elisp_string "$scope" || printf nil ) ${limit:-nil} $arm)) 'utf-8)"
    ;;
  scopes) form="(decode-coding-string (progn (require 'arc-tool) (arc-tool-scopes)) 'utf-8)" ;;
  stats)  form="(decode-coding-string (progn (require 'arc-tool) (arc-tool-stats)) 'utf-8)" ;;
  --help|-h) usage ;;
  *) die "unknown command: $cmd" ;;
esac

out=$(evaluate "$form") || exit $?

if [ "$json" -eq 1 ]; then
  printf '%s\n' "$out"
else
  # Plain text by default. jq is optional: fall back to the raw JSON.
  if command -v jq >/dev/null 2>&1; then
    case "$cmd" in
      # Header once per document, then its passages. The passage list must be
      # a SEPARATE jq output (comma), not interpolated into the header string:
      # `\(.passages[] | ...)` inside one string makes jq emit the whole string
      # once per passage, repeating the header for every matched line.
      search) printf '%s' "$out" | jq -r '.results[] | "\(.path // .option_name // .info_node)  [\(.chunks) match(es), score \(.score|.*1000|round/1000)]", (.passages[] | "    \(.line_start // "-"): \(.text | gsub("[ \t\n]+"; " ") | .[0:160])")' ;;
      scopes) printf '%s' "$out" | jq -r '.scopes[] | "\(.name)  (\(.chunks) chunks)"' ;;
      stats)  printf '%s' "$out" | jq -r '"chunks: \(.chunks)  sources: \(.sources)", (.kinds[] | "  \(.kind): \(.chunks)"), (.collections[] | "  \(.collection): \(.sources) source(s), \(.chunks) chunk(s), last indexed \(if .last_indexed_at then (.last_indexed_at|strflocaltime("%Y-%m-%d %H:%M")) else "never" end)"), (.freshness[] | "  \(.collection): \(.state)")' ;;
    esac
  else
    printf '%s\n' "$out"
  fi
fi
